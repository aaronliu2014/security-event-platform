# ============================================
# Railway 生产环境配置
# 在 Railway 控制台中配置这些环境变量
# ============================================

# 运行模式
NODE_ENV=production

# 服务端口 (Railway 自动设置 PORT)
# PORT=3000

# 前端地址 (GitHub Pages)
FRONTEND_URL=https://aaronliu2014.github.io

# JWT 密钥 (请替换为随机字符串)
JWT_SECRET=your-production-jwt-secret-change-me

# 数据采集频率 (daily | hourly | twice-daily | weekly)
COLLECTION_FREQUENCY=daily

# ============================================
# 数据库配置 (二选一)
# ============================================

# 选项 A: 使用 SQLite + Railway Volume
# 在 Railway 中挂载 Volume 到 /app/data
DB_PATH=/app/data/local.db

# 选项 B: 使用 Railway PostgreSQL (推荐)
# Railway 会自动注入 DATABASE_URL，无需手动配置
# 如果同时提供 PostgreSQL 环境变量，系统优先使用 PostgreSQL
# DB_USER=postgres
# DB_PASSWORD=***
# DB_HOST=***.railway.internal
# DB_PORT=5432
# DB_NAME=security_events
