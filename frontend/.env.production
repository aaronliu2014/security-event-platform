# ============================================
# GitHub Pages 生产环境配置
# 部署前请将下方 URL 替换为你的 Railway 后端地址
# ============================================

# Railway 后端 API 地址 (部署后端到 Railway 后获取)
REACT_APP_API_URL=https://YOUR-APP.up.railway.app/api

# WebSocket 地址 (Railway 自动支持 wss://)
REACT_APP_WS_URL=wss://YOUR-APP.up.railway.app
